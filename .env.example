# Copy to .env for local development (npm run dev). On Vercel, add these under
# Project → Settings → Environment Variables instead. Never commit real keys.

# ESV — free non-commercial key from https://api.esv.org/
ESV_API_KEY=

# NLT — free non-commercial key from https://api.nlt.to/
NLT_API_KEY=

# Claude, for discussion questions — https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Optional: require this passcode before anyone can use ESV, NLT or Claude through your site.
APP_PASSCODE=

# Optional overrides
# CLAUDE_MODEL=claude-opus-5-5
# CLAUDE_EFFORT=low
